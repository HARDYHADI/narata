NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_READ_ACCESS_TOKEN=
OPENAI_API_KEY=

# Shared secret for /api/admin/* routes, sent as an `Authorization: Bearer <secret>`
# header (not a query param, so it stays out of request logs and browser history).
# Generate a long random value; never reuse another secret for this.
INGEST_ADMIN_SECRET=

# Cloudflare Turnstile (CAPTCHA) for anonymous community post/comment
# submissions. Optional: if TURNSTILE_SECRET_KEY is unset, server-side
# verification is skipped (with a warning) and the feature stays fully
# functional but unprotected. Sign up at https://dash.cloudflare.com/?to=/:account/turnstile
# and set both of these to actually enforce it.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
